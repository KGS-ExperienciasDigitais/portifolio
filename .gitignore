# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# referências de terceiros
/referencias/

# imagens brutas (as versões usadas pelo site estão em public/)
/caso1-img/
/caso2-img/
/hero/
/tools-logos/

# documentação interna (fica só no computador, nunca vai para o git)
/memoria/
/specs/
/CLAUDE.md
/AGENTS.md
/README.md
